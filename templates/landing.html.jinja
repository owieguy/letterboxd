<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Free to watch — your lists</title>
<style>
  :root {
    color-scheme: light dark;
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --text-primary: #0b0b0b;
    --text-secondary: #52514e;
    --text-muted: #898781;
    --border: rgba(11, 11, 11, 0.10);
    --series-1: #2a78d6;
    --status-good: #0ca30c;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0d0d0d;
      --surface: #1a1a19;
      --text-primary: #ffffff;
      --text-secondary: #c3c2b7;
      --text-muted: #8b8a84;
      --border: rgba(255, 255, 255, 0.10);
      --series-1: #3987e5;
      --status-good: #0ca30c;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--text-primary);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  header, main, footer { max-width: 900px; margin: 0 auto; }
  header { padding: 2.5rem 1.5rem 0.5rem; }
  h1 { margin: 0 0 0.3rem; font-size: 1.7rem; letter-spacing: -0.01em; }
  .subtitle { color: var(--text-secondary); font-size: 0.95rem; margin: 0; }
  main { padding: 1.5rem 1.5rem 3rem; display: flex; flex-direction: column; gap: 1rem; }
  .list-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  .list-card:hover { border-color: var(--series-1); }
  .list-card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .list-title { font-size: 1.15rem; font-weight: 700; }
  .list-arrow { color: var(--series-1); font-size: 0.85rem; white-space: nowrap; }
  .list-stats { color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.4rem; }
  .list-stats strong { color: var(--status-good); }
  .empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 2rem;
    text-align: center;
  }
  footer {
    padding: 1rem 1.5rem 3rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    border-top: 1px solid var(--border);
  }
  .refresh-line { margin: 0.7rem 0 0; font-size: 0.82rem; color: var(--text-muted); }
  .refresh-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid var(--border);
  }
  .refresh-button:hover { border-color: var(--series-1); color: var(--series-1); }
</style>
</head>
<body>
<header>
  <h1>Free to watch</h1>
  <p class="subtitle">{{ lists|length }} list{{ 's' if lists|length != 1 else '' }} tracked · generated {{ generated_at }}</p>
  {% if refresh_workflow_url %}
  <p class="refresh-line">
    <a class="refresh-button" href="{{ refresh_workflow_url }}" target="_blank" rel="noopener">🔄 Refresh all lists</a>
    — opens GitHub Actions; click "Run workflow" to re-check every list now (takes ~1&ndash;2 min, then reload). Otherwise this updates automatically every week.
  </p>
  {% endif %}
</header>

<main>
  {% for row in lists %}
  <a class="list-card" href="{{ row.output_file }}">
    <div class="list-card-top">
      <div class="list-title">{{ row.title }}</div>
      <div class="list-arrow">View list →</div>
    </div>
    <div class="list-stats">
      <strong>{{ row.free_count }}</strong> of {{ row.film_count }} films free somewhere in {{ row.country }}
      {%- if row.unresolved_count %} · {{ row.unresolved_count }} unmatched{% endif %}
    </div>
  </a>
  {% else %}
  <div class="empty">No lists processed yet — run the script to generate one.</div>
  {% endfor %}
</main>

<footer>
  <p>Streaming availability data provided by JustWatch, via The Movie Database (TMDB).</p>
</footer>
</body>
</html>
