# Copy this file to `.env` and fill in your values.

# Required. Get a free API key at https://www.themoviedb.org/settings/api
# (sign up, then "Request an API Key" -> choose "Developer" -> fill the short
# form; no payment info needed). Use the "API Key (v3 auth)" value below.
TMDB_API_KEY=

# The Letterboxd lists to check, comma- or newline-separated. Each gets its
# own generated page (auto-named from the list's title), plus a landing
# page (output/index.html) linking to all of them. Short boxd.it links or
# full letterboxd.com URLs both work.
LIST_URLS=https://boxd.it/il1fQ,https://boxd.it/Skwgs,https://boxd.it/8HjM

# Region to check streaming availability for (ISO 3166-1 country code).
# Peacock/Hulu/HBO/Paramount+ availability data is only meaningful for US.
COUNTRY=US
